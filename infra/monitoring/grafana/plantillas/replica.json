              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Antigüedad de último replay",
      "description": "Puede crecer sin retraso cuando no hay nuevas escrituras; contrastar con LSN y actividad del primario.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_local"
