{
  "uid": "disponibilidad_local",
  "title": "API y PostgreSQL · disponibilidad",
  "description": "Blackbox comprueba HTTP 200 y cuerpo de health/database. pg_up comprueba la conexión del exporter con el rol dedicado.",
  "tags": [
    "docker",
    "practica"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "API y base conectadas · prueba HTTP",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_local"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"api_disponibilidad\"}",
          "legendFormat": "Sonda API",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_local"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
