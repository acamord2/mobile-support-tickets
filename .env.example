# Solo nombres y rutas; este archivo no almacena contraseñas ni JWT.
# Puede utilizarse directamente con: docker compose --env-file .env.example config --quiet
# Los secretos reales están fuera del repositorio y se montan en solo lectura.
API_USER_SECRETS_FILE=/var/lib/mobile-support-tickets/prueba_docker/secrets.json
POSTGRES_PASSWORD_FILE=/var/lib/mobile-support-tickets/prueba_docker/postgres.key
POSTGRES_DB=tickets_db
POSTGRES_USER=tickets_practica

# La conexión del archivo User Secrets usa Host=postgres;Port=5432.
# Si cambias DB o USER, actualiza también esa configuración externa.
# No cambies las credenciales de un volumen existente sin un procedimiento SQL explícito.
# Permisos esperados: secrets.json propietario 1654:1654 y modo 0400;
# postgres.key propietario root:root y modo 0400. No usar chmod 777 ni cat sobre secretos.
# .env, .env.* (salvo este ejemplo), secrets.json y *.key ya están ignorados por Git.

# Rutas de complementos activos; nunca valores de credenciales.
API_SEPARACION_SECRETS_FILE=/var/lib/mobile-support-tickets/prueba_docker/secrets-lectura-escritura.json
REPLICA_PGPASS_FILE=/var/lib/mobile-support-tickets/prueba_docker/replicacion.pgpass
REPLICA_RESPALDO_OK=/var/lib/mobile-support-tickets/prueba_docker/respaldo-verificado.json
GRAFANA_ADMIN_PASSWORD_FILE=/var/lib/mobile-support-tickets/prueba_docker/monitoring/grafana_admin.key
POSTGRES_MONITOR_PASSWORD_FILE=/var/lib/mobile-support-tickets/prueba_docker/monitoring/postgres_monitor.key
SUPERVISION_METRICAS_DIR=/home/econt/.local/state/tickets-supervision/metricas
DOCKER_ROOT_DIR=/var/lib/docker
